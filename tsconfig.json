{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": true,
    "isolatedDeclarations": true,
    "declaration": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vitest/globals", "node"],
    "baseUrl": ".",
    "paths": {
      "@felix-hz/seamount-react": ["packages/seamount-react/src/index.ts"],
      "@felix-hz/seamount/format": ["packages/seamount/src/lib/format.ts"],
      "@felix-hz/seamount/theme": ["packages/seamount/src/lib/theme.ts"]
    }
  },
  "include": ["packages/*/src", "stories", "test", ".storybook"]
}
