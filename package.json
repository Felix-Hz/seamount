{
  "name": "seamount-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "storybook dev -p 6006",
    "storybook:build": "storybook build -o storybook-static",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:storybook": "vitest run --project 'storybook-*'",
    "check:package": "pnpm -r check:package",
    "changeset": "changeset",
    "release": "node scripts/publish.mjs"
  },
  "devDependencies": {
    "@felix-hz/seamount": "workspace:*",
    "@felix-hz/seamount-react": "workspace:*",
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.6.8",
    "@changesets/cli": "^3.0.3",
    "@storybook/addon-a11y": "^10.6.8",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/addon-vitest": "^10.6.8",
    "@storybook/react-vite": "^10.6.8",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser": "^5.1.1",
    "@vitest/browser-playwright": "^5.1.1",
    "happy-dom": "^21.0.4",
    "playwright": "^1.65.1",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.8",
    "tsdown": "^0.23.7",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.8.1"
  }
}
